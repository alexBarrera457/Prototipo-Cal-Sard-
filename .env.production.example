SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada_para_admin

# Proveedor de Correos Transaccionales (Resend / SendGrid / Supabase Edge Functions)
