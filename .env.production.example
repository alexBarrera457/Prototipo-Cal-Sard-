RESEND_API_URL=https://api.resend.com/emails
NOTIFICATION_STORE_EMAIL=sarda@calsarda.com
NOTIFICATION_SENDER_EMAIL=pedidos@calsarda.com

# Pasarela de Pagos (Stripe / Redsys / Bizum)
