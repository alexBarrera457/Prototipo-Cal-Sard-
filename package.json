{
  "name": "cal-sarda-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start --workspace=@cal-sarda/app",
    "build": "npm run build --workspace=@cal-sarda/app",
    "test": "npm test --workspace=@cal-sarda/app -- --watch=false",
    "test:watch": "npm test --workspace=@cal-sarda/app",
    "test:e2e": "playwright test",
    "generate:seo": "node scripts/generate-seo-files.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1"
  }
}
